# API origin of the Notra Worker (no trailing slash). Leave empty when the admin app is served from the same origin as the API.
VITE_API_BASE=https://api.example.com
# Web OAuth client id (same Google project as the app; add the admin origin under "Authorized JavaScript origins").
# Leave empty to offer mobile-OTP sign-in only.
VITE_GOOGLE_CLIENT_ID=
