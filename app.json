{
  "expo": {
    "name": "Notra Diary",
    "slug": "notra-diary",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "notradiary",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "app.notra.diary",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "आवाज़ से नोतरा की एंट्री दर्ज करने के लिए माइक्रोफ़ोन चाहिए।"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FBF6EC",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.notra.diary",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.READ_SMS",
        "android.permission.READ_CALL_LOG",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.MANAGE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF6EC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "आवाज़ से नोतरा की एंट्री दर्ज करने के लिए माइक्रोफ़ोन चाहिए।",
          "speechRecognitionPermission": "बोली हुई एंट्री को लिखने के लिए स्पीच रिकग्निशन चाहिए।"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "परिवार की फ़ोटो खींचने के लिए कैमरा चाहिए।",
          "photosPermission": "परिवार की फ़ोटो चुनने के लिए गैलरी चाहिए।"
        }
      ],
      "expo-secure-store",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.REPLACE_WITH_IOS_CLIENT_ID"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "minSdkVersion": 26,
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ]
          }
        }
      ],
      "./plugins/withReleaseSigning"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "jsEngine": "hermes",
    "extra": {
      "apiUrl": "https://api.notra-diary.example",
      "googleWebClientId": "REPLACE_WITH_WEB_CLIENT_ID.apps.googleusercontent.com"
    }
  }
}
